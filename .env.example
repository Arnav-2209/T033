# Copy to .env for local development. Never use these examples for production.
NODE_ENV=development
WEB_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://sgrs:sgrs_local_only@localhost:54329/sgrs?schema=public
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_SECONDS=60
EVIDENCE_STORAGE_DIR=.data/evidence
INSTITUTION_TIME_ZONE=Asia/Kolkata
# Used only by the synthetic seed script. Choose a local-only password before seeding.
SGRS_SEED_PASSWORD=change-this-local-demo-password
