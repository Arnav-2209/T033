{
  "name": "@sgrs/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sgrs/api": "workspace:*",
    "dotenv": "^17.2.3"
  },
  "scripts": {
    "dev": "pnpm --filter @sgrs/api build && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "pnpm --filter @sgrs/api build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8"
  }
}
